# Main Concept from sir notes
class Student:
    def __init__(self, n, e, a):
        self.name = n
        self.email = e
        self.age = a
        print(f"Current object address: {id(self)}")

s1 = Student("Neeraj", "n@gmail.com", 38)
print(f"Data: {s1.name}, {s1.email}, {s1.age}")